{
  "name": "@mopeyjellyfish/pi-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "A rigorously tested monorepo of extensions for the Pi coding agent.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/frontend-developer/src/index.ts",
      "./packages/hashline/src/index.ts",
      "./packages/playwright-cleanup/src/index.ts",
      "./packages/question/src/index.ts",
      "./packages/simple-english/src/index.ts",
      "./packages/status-line/src/index.ts",
      "./packages/todo/src/index.ts",
      "./packages/web-search/src/index.ts",
      "./packages/worktrunk/src/index.ts",
      "./node_modules/pi-claude-bridge/src/index.ts",
      "./node_modules/pi-subagents/index.ts"
    ],
    "skills": [
      "./packages/feature-flow/skills",
      "./packages/engineering/skills",
      "./packages/productivity/skills",
      "./packages/simple-english/skills",
      "./packages/git-conventions/skills",
      "./packages/github/skills",
      "./packages/worktrunk/skills",
      "./packages/frontend-developer/skills",
      "./packages/go/skills",
      "./packages/grafana-skills/skills",
      "./packages/typescript/skills",
      "./packages/trailer-production/skills"
    ],
    "prompts": [
      "./packages/feature-flow/prompts/shape.md",
      "./packages/feature-flow/prompts/plan.md",
      "./packages/engineering/prompts",
      "./packages/productivity/prompts",
      "./packages/frontend-developer/prompts/design.md",
      "./packages/frontend-developer/prompts/improve-ui.md",
      "./packages/frontend-developer/prompts/generate-image.md",
      "./packages/trailer-production/prompts/trailer.md",
      "./node_modules/pi-subagents/prompts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "scripts": {
    "check": "tsx scripts/check.ts",
    "commits:check": "commitlint --verbose",
    "fix": "npm run format && npm run lint:fix && npm run go:format",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "markdownlint": "markdownlint --dot '**/*.md' --ignore 'packages/*/prompts/*.md' && markdownlint --dot --disable MD041 -- 'packages/*/prompts/*.md'",
    "knip": "knip --no-config-hints",
    "typecheck": "tsx scripts/typecheck.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "packages:check": "tsx scripts/validate-packages.ts",
    "smoke": "tsx scripts/smoke-packages.ts",
    "smoke:source": "tsx scripts/smoke-packages.ts --source-only",
    "smoke:packed": "tsx scripts/smoke-packages.ts --packed-only",
    "dev": "bash scripts/dev.sh",
    "go:verify": "tsx scripts/go.ts verify",
    "go:format": "tsx scripts/go.ts format",
    "go:format:check": "tsx scripts/go.ts format-check",
    "go:lint": "tsx scripts/go.ts lint",
    "go:test": "tsx scripts/go.ts test",
    "go:vuln": "tsx scripts/go.ts vuln",
    "go:check": "npm run go:verify && npm run go:format:check && npm run go:lint && npm run go:test && npm run go:vuln",
    "workflows:actionlint": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12",
    "workflows:zizmor": "zizmor --persona pedantic --min-severity low --offline .github/workflows",
    "workflows:check": "npm run workflows:actionlint && npm run workflows:zizmor",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "go run github.com/zricethezav/gitleaks/v8@v8.30.1 dir . --redact --no-banner && go run github.com/zricethezav/gitleaks/v8@v8.30.1 git --redact --no-banner",
    "security:check": "npm run security:audit && npm run security:secrets",
    "profile:doctor": "tsx scripts/profile-doctor.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-unicorn": "71.1.0",
    "glob": "13.0.6",
    "globals": "17.12.0",
    "knip": "6.37.0",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.8",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "tsx": "4.23.15",
    "typebox": "1.3.34",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@playwright/cli": "0.1.21",
    "pi-claude-bridge": "0.8.0",
    "pi-subagents": "0.70.1"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "cosmiconfig": {
      "js-yaml": "4.3.2"
    },
    "baseline-browser-mapping": "2.11.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.1",
    "markdownlint-cli": {
      "js-yaml": "4.3.2",
      "markdown-it": "14.3.2",
      "run-con": "1.3.2"
    },
    "smol-toml": "1.7.1"
  }
}
