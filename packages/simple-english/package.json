{
  "name": "@mopeyjellyfish/pi-simple-english",
  "version": "0.1.0",
  "description": "A Pi extension and skill for clear human-facing text based on pragmatic ASD-STE100 rules.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "files": [
    "src/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi-skill",
    "asd-ste100",
    "simplified-technical-english",
    "documentation"
  ],
  "devDependencies": {
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mopeyjellyfish/pi-extensions.git",
    "directory": "packages/simple-english"
  },
  "scripts": {
    "test": "vitest run --root ../.. packages/simple-english/test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
