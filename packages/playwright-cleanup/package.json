{
  "name": "@mopeyjellyfish/pi-playwright-cleanup",
  "version": "0.0.0",
  "description": "Own and verify cleanup of Playwright CLI browser sessions started by Pi agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-extension",
    "pi-package",
    "playwright",
    "browser-cleanup"
  ],
  "devDependencies": {
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mopeyjellyfish/pi-extensions.git",
    "directory": "packages/playwright-cleanup"
  },
  "scripts": {
    "test": "vitest run --root ../.. packages/playwright-cleanup/test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
